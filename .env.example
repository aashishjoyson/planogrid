# Copy to .env and fill in — .env is gitignored and never committed.
# All three are free tiers; no credit card required. See docs/datasets.md for full walkthrough.

# Kaggle — kaggle.com -> Settings -> API -> "Create New Token"
# (Newer accounts get a KGAT_... token; older accounts may only have kaggle.json,
#  in which case set KAGGLE_USERNAME + KAGGLE_KEY instead of KAGGLE_API_TOKEN.)
KAGGLE_API_TOKEN=

# Roboflow — app.roboflow.com -> Settings -> API Keys -> use the PRIVATE key,
# not the "publishable" / inferencejs key (that one cannot download datasets).
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=

# HuggingFace — huggingface.co -> Settings -> Access Tokens -> New token (read scope)
HF_TOKEN=
