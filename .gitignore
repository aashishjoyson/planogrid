# Internal planning document — not part of the published project
CV_PROJECT_ROADMAP.pdf

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json
**/.kaggle/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ML artifacts — regenerated, not source. *.pt is blanket-ignored (this
# also catches yolo26n.pt / yolo26s.pt, the pretrained base weights
# Ultralytics drops in the repo root when training starts — not ours to
# ship). The three trained best.pt checkpoints are the deliberate
# exception: each is under 60MB, well under GitHub's limits, and committing
# them means the repo runs inference out of the box with no training step
# required first (last.pt and everything else under checkpoints/ stays
# excluded).
checkpoints/*
!checkpoints/product/
!checkpoints/product/best.pt
!checkpoints/gap/
!checkpoints/gap/best.pt
!checkpoints/tag/
!checkpoints/tag/best.pt
outputs/
logs/
experiments/
!experiments/.gitkeep
*.pt
!checkpoints/product/best.pt
!checkpoints/gap/best.pt
!checkpoints/tag/best.pt
*.onnx
*.engine

# Datasets — pulled via scripts/download_datasets.py, not committed
datasets/raw/
datasets/processed/
datasets/**/*.zip

# Notebooks checkpoints
.ipynb_checkpoints/

# Reports/exports generated at runtime. Training-curve charts are kept as
# a reviewed deliverable (they're results, not a report); the team guide
# PDF and its LaTeX source are deliberately excluded — that document is
# submitted separately per the assignment instructions, not pushed to
# GitHub.
reports/*
!reports/.gitkeep
!reports/training/
!reports/training/*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# TensorBoard / W&B
runs/
wandb/
