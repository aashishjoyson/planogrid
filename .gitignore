# Internal planning document — not part of the published project
CV_PROJECT_ROADMAP.pdf

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json
**/.kaggle/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ML artifacts — regenerated, not source
checkpoints/
outputs/
logs/
experiments/
!experiments/.gitkeep
*.pt
*.onnx
*.engine

# Datasets — pulled via scripts/download_datasets.py, not committed
datasets/raw/
datasets/processed/
datasets/**/*.zip

# Notebooks checkpoints
.ipynb_checkpoints/

# Reports/exports generated at runtime — the training-curve charts and the
# compiled team guide are kept as reviewed deliverables, everything else
# under reports/ (raw eval CSVs, etc.) is regenerated by training/plots.py
reports/*
!reports/.gitkeep
!reports/training/
!reports/training/*.png
!reports/Planogrid_Team_Guide.pdf
!reports/guide_source/
!reports/guide_source/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# TensorBoard / W&B
runs/
wandb/
