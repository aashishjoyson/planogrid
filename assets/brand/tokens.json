{
  "$schema": "https://planogrid.dev/schema/brand-tokens.json",
  "brand": {
    "name": "Planogrid",
    "tagline": "See every gap. Verify every tag.",
    "description": "Retail shelf intelligence: detection, OCR, and compliance in one pipeline."
  },
  "color": {
    "primary": "#F59E0B",
    "primaryHover": "#D97706",
    "primaryMuted": "#FBBF2433",
    "surface": "#0F172A",
    "surfaceElevated": "#1E293B",
    "surfaceBorder": "#334155",
    "textPrimary": "#F8FAFC",
    "textSecondary": "#CBD5E1",
    "textMuted": "#94A3B8",
    "semantic": {
      "ok": "#10B981",
      "missingTag": "#EF4444",
      "misaligned": "#F97316",
      "gap": "#3B82F6"
    }
  },
  "typography": {
    "display": "'Space Grotesk', 'Segoe UI', system-ui, sans-serif",
    "body": "'Inter', 'Segoe UI', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Code', ui-monospace, monospace",
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px"
  },
  "logo": {
    "mark": "mark.svg",
    "faviconSvg": "favicon.svg",
    "lightBackground": "logo-light.svg",
    "darkBackground": "logo-dark.svg",
    "banner": "banner.svg"
  }
}
